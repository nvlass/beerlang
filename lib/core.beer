; Beerlang Core Macros
; Loaded at startup by the runtime.

; Fns that call a fn they're given are beerlang (on apply), not natives: the
; fn then runs in the caller's VM, where it can yield and be interrupted.
; Defined first: def/defn docstrings expand to alter-meta!.

(def alter-meta!
  (fn alter-meta! [sym f & args]
    (__set-meta! sym (apply f (meta sym) args))))

; Retries if another task changed the atom while f ran (f may run more
; than once, as in Clojure)
(def swap!
  (fn swap! [a f & args]
    (loop []
      (let* [old (deref a)
             new (apply f old args)]
        (if (compare-and-set! a old new) new (recur))))))

; defn: convenience for (def name (fn name ...))
; Single arity:  (defn name [params] body...)
; Multi-arity:   (defn name ([params1] body1...) ([params2] body2...) ...)
; Optional docstring: (defn name "docstring" [params] body...)
; The var's meta gets :arglists, one parameter vector per arity, and :doc.
(defmacro defn "Defines name as a fn: (defn name doc? [params] body...) or (defn name doc? ([params] body...) ...). Records :arglists and :doc." [name & fdecl]
  (let* [has-doc (string? (first fdecl))
         docstring (if has-doc (first fdecl) nil)
         fdecl (if has-doc (rest fdecl) fdecl)
         ; ^meta name reads as (__meta-sym meta name): def takes it as is,
         ; fn and alter-meta! want the symbol
         sym (if (list? name) (first (rest (rest name))) name)
         ; fn handles both [params] body... and ([params] body...) clauses
         base (list (quote def) name (cons (quote fn) (cons sym fdecl)))
         ; map isn't defined yet here
         arglists (if (vector? (first fdecl))
                    (list (first fdecl))
                    ((fn clause-params [cs]
                       (if (= (count cs) 0)
                         nil
                         (cons (first (first cs)) (clause-params (rest cs)))))
                     fdecl))
         meta-args (list :arglists (list (quote quote) arglists))
         meta-args (if has-doc (cons :doc (cons docstring meta-args)) meta-args)]
    (list (quote do) base
          (cons (quote alter-meta!) (cons (list (quote quote) sym) (cons (quote assoc) meta-args)))
          sym)))

; Defined with def before defn existed
(alter-meta! 'alter-meta! assoc :arglists '([ref f & args])
             :doc "Sets the metadata of a var, or of the var the symbol ref names, to (f old-meta args...).")
(alter-meta! 'swap! assoc :arglists '([a f & args])
             :doc "Sets atom a to (f old-value args...) and returns it. Retries if another task changed a meanwhile, so f may run more than once.")

; doc: print documentation for a symbol
(defmacro doc "Prints the arglists and docstring of the var sym names." [sym]
  (list (quote __print-doc) (str sym) (list (quote meta) (list (quote quote) sym))))

; when: (when test body...) => (if test (do body...) nil)
(defmacro when "Evaluates body if test is truthy, else nil." [test & body]
  (list (quote if) test (cons (quote do) body) nil))

; and: short-circuit logical and
(defmacro and "Evaluates the forms left to right and returns the first falsy value (nil or false), else the last value. (and) is true." [& args]
  (if (empty? args) true
    (if (= (count args) 1) (first args)
      (let* [v (gensym "and__")]
        (list (quote let*) [v (first args)]
              (list (quote if) v
                    (cons (quote and) (rest args))
                    v))))))

; or: short-circuit logical or (uses gensym to avoid double evaluation)
(defmacro or "Evaluates the forms left to right and returns the first truthy value, else the last value. (or) is nil." [& args]
  (if (empty? args) nil
    (if (= (count args) 1) (first args)
      (let* [v (gensym "or__")]
        (list (quote let*) [v (first args)]
              (list (quote if) v v
                    (cons (quote or) (rest args))))))))

; cond: (cond test1 expr1 test2 expr2 ... :else default)
(defmacro cond "Takes test/expr pairs; evaluates the expr of the first truthy test, else nil. Use :else as a last catch-all test." [& clauses]
  (if (empty? clauses) nil
    (if (= (count clauses) 1)
      (first clauses)
      (list (quote if) (first clauses)
        (first (rest clauses))
        (cons (quote cond) (rest (rest clauses)))))))

; ->: thread-first macro
; (-> x (f a) (g b)) => (g (f x a) b)
(defmacro -> "Threads x through the forms as their first argument: (-> x (f a) g) is (g (f x a))." [x & forms]
  (if (empty? forms) x
    (let* [form (first forms)
           threaded (if (list? form)
                      (cons (first form) (cons x (rest form)))
                      (list form x))]
      (cons (quote ->) (cons threaded (rest forms))))))

; ->>: thread-last macro
; (->> x (f a) (g b)) => (g a (f a x))  -- actually (g b (->> x (f a)))
(defmacro ->> "Threads x through the forms as their last argument: (->> x (f a) g) is (g (f a x))." [x & forms]
  (if (empty? forms) x
    (let* [form (first forms)
           threaded (if (list? form)
                      (concat form (list x))
                      (list form x))]
      (cons (quote ->>) (cons threaded (rest forms))))))

; --- let with destructuring ---
; Helper: build nthrest expression (chain of rest calls)
(defn __nthrest-expr [sym n]
  (loop [i 0 v sym]
    (if (= i n) v
      (recur (+ i 1) (list 'rest v)))))

; Helper: flat let* binding pairs for binding `target` (a symbol or a
; destructuring vector or map, possibly nested) to expr
(defn __bind-pairs [target expr]
  (cond (vector? target) (__expand-destructure target expr)
        (map? target) (__expand-map-destructure target expr)
        :else (list target expr)))

; The map a map pattern destructures: a seq (& {:keys [...]} rest args)
; becomes a map of its key/value pairs
(defn __destr-map [x]
  (if (or (list? x) (vector? x)) (apply hash-map x) x))

; {:keys [a b] :strs [c] :syms [d] :or {a 1} :as m, e :e, [f g] :fg}
(defn __expand-map-destructure [pattern expr]
  (let* [tmp (gensym "mdestr__")
         defaults (get pattern :or {})
         lookup (fn [sym k]
                  (if (contains? defaults sym)
                    (list 'get tmp k (get defaults sym))
                    (list 'get tmp k)))
         ; :keys entries may be symbols, keywords or qualified (a/b binds b)
         key-binds (fn [names make-key]
                     (reduce (fn [acc n]
                               (let* [sym (symbol (name n))]
                                 (concat acc (list sym (lookup sym (make-key n))))))
                             '() names))]
    (reduce
      (fn [acc e]
        (let* [k (first e) v (first (rest e))]
        (cond (= k :as) (concat acc (list v tmp))
              (= k :or) acc
              (= k :keys) (concat acc (key-binds v (fn [n] (if (namespace n)
                                                             (keyword (namespace n) (name n))
                                                             (keyword (name n))))))
              (= k :strs) (concat acc (key-binds v (fn [n] (name n))))
              (= k :syms) (concat acc (key-binds v (fn [n] (list 'quote (symbol (name n))))))
              (symbol? k) (concat acc (list k (lookup k v)))
              :else (concat acc (__bind-pairs k (list 'get tmp v))))))
      (list tmp (list '__destr-map expr))
      pattern)))

; Helper: expand a destructuring vector pattern into flat let* binding pairs
(defn __expand-destructure [pattern expr]
  (let* [tmp (gensym "destr__")]
    (loop [i 0
           bindings (list tmp expr)
           elems pattern]
      (if (empty? elems)
        bindings
        (let* [elem (first elems)]
          (if (= elem '&)
            (concat bindings (__bind-pairs (first (rest elems))
                                           (__nthrest-expr tmp i)))
            (if (= elem :as)
              (concat bindings (list (first (rest elems)) tmp))
              (recur (+ i 1)
                     (concat bindings (__bind-pairs elem (list 'nth tmp i nil)))
                     (rest elems)))))))))

; Helper: expand all bindings, handling destructuring vectors
(defn __expand-bindings [bindings]
  (loop [i 0
         result '()]
    (if (>= i (count bindings))
      result
      (let* [binding (nth bindings i)
             expr    (nth bindings (+ i 1))]
        (recur (+ i 2) (concat result (__bind-pairs binding expr)))))))

; let: supports destructuring via macro expansion to let*
(defmacro let "Binds names to values for body, in order. Vector and map bindings destructure: [[a b & more] coll], {:keys [a b] :or {a 1} :as m}, {x :x}." [bindings & body]
  (let* [expanded (__expand-bindings bindings)]
    (cons 'let* (cons (apply vector expanded) body))))

(defmacro if-let "If test is truthy, evaluates then with name bound to it; else the else form (or nil). bindings: [name test]." [bindings then & else]
  (let* [tmp (gensym "iflet__")]
    (list 'let* [tmp (nth bindings 1)]
      (list 'if tmp
        (list 'let [(nth bindings 0) tmp] then)
        (first else)))))

(defmacro when-let "If test is truthy, evaluates body with name bound to it; else nil. bindings: [name test]." [bindings & body]
  (let* [tmp (gensym "whenlet__")]
    (list 'let* [tmp (nth bindings 1)]
      (list 'when tmp
        (cons 'let (cons [(nth bindings 0) tmp] body))))))


; --- Numeric utilities ---
(defn inc "x plus one." [x] (+ x 1))
(defn dec "x minus one." [x] (- x 1))
(defn zero? "True if x is zero." [x] (= x 0))
(defn pos? "True if x is greater than zero." [x] (> x 0))
(defn neg? "True if x is less than zero." [x] (< x 0))
(defn even? "True if the integer x is even." [x] (= 0 (mod x 2)))
(defn odd? "True if the integer x is odd." [x] (not (even? x)))

; --- Comparison utilities ---
(defn not= "Same as (not (= a b))." [a b] (not (= a b)))
(defn max "The greatest of the numbers." [x & more] (reduce (fn [a b] (if (> a b) a b)) x more))
(defn min "The smallest of the numbers." [x & more] (reduce (fn [a b] (if (< a b) a b)) x more))
(defn abs "The absolute value of x." [x] (if (neg? x) (- x) x))

; --- Function utilities ---
(defn identity "Returns x." [x] x)
(defn boolean "true unless x is nil or false" [x] (if x true false))
(defn constantly "A fn that takes any arguments and returns x." [x] (fn [& _] x))
(defn complement "A fn that returns the boolean opposite of f's result." [f] (fn [& args] (not (apply f args))))
(defn comp "The composition of the fns, applied right to left: ((comp f g) x) is (f (g x)). (comp) is identity." [& fns]
  (if (empty? fns) identity
    (if (empty? (rest fns)) (first fns)
      (let* [f (first fns)
             g (apply comp (rest fns))]
        (fn [& args] (f (apply g args)))))))
(defn partial "A fn that calls f with the bound args followed by its own." [f & bound]
  (fn [& args] (apply f (concat bound args))))
(defn juxt "A fn that returns a vector of each fn applied to its arguments." [& fns]
  (fn [& args]
    (let* [results (map (fn [f] (apply f args)) fns)]
      (into [] results))))

; --- Collection utilities ---
; Builders accumulate in reverse with cons (O(1)) and flip once with __rev,
; instead of (concat acc (list x)), which copies acc every step. Loops start
; from (__seq coll) because rest on a vector copies the remainder each call.
(defn __rev [lst]
  (loop [s lst acc '()]
    (if (empty? s)
      acc
      (recur (rest s) (cons (first s) acc)))))

(defn filter "A list of the elements of coll for which pred is truthy." [pred coll]
  (loop [s   (__seq coll)
         acc '()]
    (if (empty? s)
      (__rev acc)
      (recur (rest s)
             (if (pred (first s))
               (cons (first s) acc)
               acc)))))

(defn reduce
  "(reduce f coll) starts from the first element; (f) for an empty coll."
  ([f coll]
    (let* [s (__seq coll)]
      (if (empty? s) (f) (reduce f (first s) (rest s)))))
  ([f init coll]
    (loop [acc init
           s   (__seq coll)]
      (if (empty? s)
        acc
        (recur (f acc (first s)) (rest s))))))

; (f acc k v) for each entry of a map (or nil)
(defn reduce-kv "Reduces map m with (f acc k v) for each entry, starting from init." [f init m]
  (if (or (nil? m) (map? m))
    (reduce (fn [acc k] (f acc k (get m k))) init (keys m))
    (throw {:message "reduce-kv: third argument must be a map or nil"})))

(defn map "A list of (f x) for each element x of coll." [f coll]
  (loop [s   (__seq coll)
         acc '()]
    (if (empty? s)
      (__rev acc)
      (recur (rest s) (cons (f (first s)) acc)))))

; --- More collection utilities ---
(defn second "The second element of coll." [coll] (first (rest coll)))
(defn ffirst "Same as (first (first coll))." [coll] (first (first coll)))

(defn last "The last element of coll, or nil if empty." [coll]
  (loop [s (__seq coll)]
    (if (empty? (rest s))
      (first s)
      (recur (rest s)))))

(defn butlast "A list of all but the last element of coll." [coll]
  (loop [s (__seq coll) acc '()]
    (if (empty? (rest s))
      (__rev acc)
      (recur (rest s) (cons (first s) acc)))))

(defn take "A list of the first n elements of coll (fewer if it is shorter)." [n coll]
  (loop [i 0 s (__seq coll) acc '()]
    (if (or (= i n) (empty? s))
      (__rev acc)
      (recur (+ i 1) (rest s) (cons (first s) acc)))))

; drop/drop-while return the remainder itself, so coll is only converted
; once at least one element is actually dropped -- (drop 0 v) stays v.
(defn drop "coll without its first n elements; coll itself when n <= 0." [n coll]
  (if (or (<= n 0) (empty? coll))
    coll
    (loop [i 1 s (rest (__seq coll))]
      (if (or (= i n) (empty? s))
        s
        (recur (+ i 1) (rest s))))))

(defn take-while "A list of the leading elements of coll for which pred is truthy." [pred coll]
  (loop [s (__seq coll) acc '()]
    (if (or (empty? s) (not (pred (first s))))
      (__rev acc)
      (recur (rest s) (cons (first s) acc)))))

(defn drop-while "coll without the leading elements for which pred is truthy." [pred coll]
  (if (or (empty? coll) (not (pred (first coll))))
    coll
    (loop [s (rest (__seq coll))]
      (if (or (empty? s) (not (pred (first s))))
        s
        (recur (rest s))))))

(defn partition
  "Lists of n items each, starting a new one every step items (default n).
  A final chunk with fewer than n items is dropped."
  ([n coll] (partition n n coll))
  ([n step coll]
    (if (or (< n 1) (< step 1))
      (throw (ex-info "partition: n and step must be positive" {:n n :step step}))
      (loop [s (__seq coll) acc '()]
        (let* [chunk (take n s)]
          (if (< (count chunk) n)
            (__rev acc)
            (recur (drop step s) (cons chunk acc))))))))

(defn range "A list of numbers from start (default 0) up to but not including end, by step (default 1; may be negative)."
  ([end] (range 0 end 1))
  ([start end] (range start end 1))
  ([start end step]
    (let* [done? (cond (pos? step) (fn [i] (>= i end))
                       (neg? step) (fn [i] (<= i end))
                       :else (throw (ex-info "range: step must be non-zero" {:step step})))]
      (loop [i start acc '()]
        (if (done? i)
          (__rev acc)
          (recur (+ i step) (cons i acc)))))))

(defn repeat "A list of n copies of x." [n x]
  (loop [i 0 acc '()]
    (if (= i n)
      acc
      (recur (+ i 1) (cons x acc)))))

(defn repeatedly "A list of the results of n calls to the no-argument fn f." [n f]
  (loop [i 0 acc '()]
    (if (= i n)
      (__rev acc)
      (recur (+ i 1) (cons (f) acc)))))

(defn reverse "A list of coll's elements in reverse order." [coll]
  (reduce (fn [acc x] (cons x acc)) '() coll))

(defn into "from's elements added to the collection to with conj." [to from]
  (reduce conj to from))

(defn vec "A vector of coll's elements." [coll]
  (into [] coll))

(defn some "The first truthy (pred x) for the elements of coll, else nil." [pred coll]
  (loop [s (__seq coll)]
    (if (empty? s)
      nil
      (let* [result (pred (first s))]
        (if result result (recur (rest s)))))))

(defn every? "True if (pred x) is truthy for every element of coll (true for an empty coll)." [pred coll]
  (loop [s (__seq coll)]
    (if (empty? s)
      true
      (if (pred (first s))
        (recur (rest s))
        false))))

(defn not-any? "True if (pred x) is falsy for every element of coll." [pred coll] (not (some pred coll)))
(defn not-every? "True if (pred x) is falsy for some element of coll." [pred coll] (not (every? pred coll)))

(defn frequencies "A map from each distinct element of coll to the number of times it occurs." [coll]
  (reduce (fn [m x]
            (let* [n (get m x 0)]
              (assoc m x (+ n 1))))
          {} coll))

(defn group-by "A map from each (f x) to a list of the elements x of coll that gave it, in order." [f coll]
  (let* [reversed (reduce (fn [m x]
                            (let* [k (f x)]
                              (assoc m k (cons x (get m k '())))))
                          {} coll)]
    (reduce-kv (fn [m k v] (assoc m k (__rev v))) {} reversed)))

(defn mapcat "A list of the elements of each (f x), for each element x of coll in turn." [f coll]
  (__rev (reduce (fn [acc x] (reduce (fn [a y] (cons y a)) acc (f x)))
                 '() coll)))

(defn interleave "A list of the first item of each coll, then the second of each, ... up to the shorter one's length." [c1 c2]
  (loop [s1 (__seq c1) s2 (__seq c2) acc '()]
    (if (or (empty? s1) (empty? s2))
      (__rev acc)
      (recur (rest s1) (rest s2)
             (cons (first s2) (cons (first s1) acc))))))

(defn zipmap "A map from each element of keys to the element of vals at the same index." [keys vals]
  (loop [ks (__seq keys) vs (__seq vals) m {}]
    (if (or (empty? ks) (empty? vs))
      m
      (recur (rest ks) (rest vs) (assoc m (first ks) (first vs))))))

(defn __flatten-into [acc coll]
  (reduce (fn [a x]
            (if (or (list? x) (vector? x))
              (__flatten-into a x)
              (cons x a)))
          acc coll))

(defn flatten "A list of the non-sequential elements of coll, with nested lists and vectors spliced in." [coll]
  (__rev (__flatten-into '() coll)))

(defn distinct "A list of coll's elements without duplicates, keeping the first occurrence." [coll]
  (loop [s (__seq coll) seen {} acc '()]
    (if (empty? s)
      (__rev acc)
      (let* [x (first s)]
        (if (contains? seen x)
          (recur (rest s) seen acc)
          (recur (rest s) (assoc seen x true) (cons x acc)))))))

(defn select-keys "A map of the entries of m whose keys are in ks." [m ks]
  (reduce (fn [acc k]
            (if (contains? m k)
              (assoc acc k (get m k))
              acc))
          {} ks))

; --- Sorting ---
; A comparator is either 3-way (negative/zero/positive, like `compare`) or a
; boolean predicate "a comes before b" (like `<`). As in Clojure, a boolean
; result is turned into 3-way by also asking (comp b a).
(defn __comparator [comp]
  (fn [a b]
    (let* [r (comp a b)]
      (cond (number? r) r
            r -1
            (comp b a) 1
            :else 0))))

; Prepend the reversed `rev` onto `tail` (O(len rev), no copying of tail)
(defn __rev-onto [rev tail]
  (loop [r rev out tail]
    (if (empty? r)
      out
      (recur (rest r) (cons (first r) out)))))

; Stable merge of two sorted lists. A loop with an accumulator, so the
; depth doesn't grow with the input (cons-ing onto a recursive call did).
(defn __merge [cmp a b]
  (loop [a a b b acc '()]
    (cond (empty? a) (__rev-onto acc b)
          (empty? b) (__rev-onto acc a)
          (<= (cmp (first a) (first b)) 0) (recur (rest a) b (cons (first a) acc))
          :else (recur a (rest b) (cons (first b) acc)))))

; Top-down merge sort on a list of known length (recursion depth is log n)
(defn __sort-list [cmp lst n]
  (if (<= n 1)
    lst
    (let* [mid (quot n 2)]
      (__merge cmp
               (__sort-list cmp (take mid lst) mid)
               (__sort-list cmp (drop mid lst) (- n mid))))))

(defn sort
  "Sorted sequence of coll's elements, by `compare` or the given comparator
  (3-way or boolean predicate). Stable. With `compare` (the default) the
  sort runs natively; a custom comparator is called per comparison."
  ([coll] (__sort-native coll))
  ([comp coll]
    (if (= comp compare)
      (__sort-native coll)
      (let* [s (__seq coll)]
        (__sort-list (__comparator comp) s (count s))))))

(defn sort-by
  "Sort coll by (keyfn x), using `compare` or the given comparator. Stable.
  With `compare` (the default) keyfn runs once per element and the sort
  runs natively."
  ([keyfn coll] (__sort-pairs-native (map (fn [x] [(keyfn x) x]) coll)))
  ([keyfn comp coll]
    (if (= comp compare)
      (sort-by keyfn coll)
      (let* [cmp (__comparator comp)]
        (sort (fn [a b] (cmp (keyfn a) (keyfn b))) coll)))))

; --- Nested collection access ---
(defn get-in "The value in nested associative structures at the path of keys ks." [m ks]
  (reduce get m ks))

(defn assoc-in "Sets the value at the path of keys ks in nested maps to v, creating maps where missing." [m ks v]
  (if (= (count ks) 1)
    (assoc m (first ks) v)
    (assoc m (first ks)
           (assoc-in (get m (first ks) {}) (rest ks) v))))

(defn update "m with the value at k replaced by (f old-value args...)." [m k f & args]
  (assoc m k (apply f (get m k) args)))

(defn update-in "Like update, at the path of keys ks in nested maps." [m ks f & args]
  (if (= (count ks) 1)
    (apply update m (first ks) f args)
    (assoc m (first ks)
           (apply update-in (get m (first ks) {}) (rest ks) f args))))

(defn merge "A map of the entries of all the maps; later keys win. nil maps are skipped." [& maps]
  (reduce (fn [acc m]
            (if (nil? m) acc
              (reduce (fn [a k] (assoc a k (get m k)))
                      acc (keys m))))
          {} maps))

; --- I/O helpers ---
(defmacro with-open "Binds name to init, evaluates body and closes name afterwards, also on throw. bindings: [name init]." [bindings & body]
  (let* [name (first bindings)
         init (second bindings)
         result (gensym "result__")]
    (list (quote let*) [name init]
      (list (quote try)
        (list (quote let*) [result (cons (quote do) body)]
          (list (quote close) name)
          result)
        (list (quote catch) (quote e)
          (list (quote do)
            (list (quote close) name)
            (list (quote throw) (quote e))))))))

; doseq: iterate a collection for side effects
; (doseq [x coll] body...)
(defmacro dotimes "Evaluates body n times with name bound to 0 .. n-1; returns nil. bindings: [name n]." [bindings & body]
  (let* [i (first bindings)
         n (gensym "n__")]
    (list 'let* [n (second bindings)]
      (list 'loop [i 0]
        (list 'when (list '< i n)
          (cons 'do body)
          (list 'recur (list 'inc i)))))))

(defmacro doseq "Evaluates body once per element of coll with name bound to it (name may destructure: [[k v] m]); returns nil. bindings: [name coll]." [bindings & body]
  (let* [sym (first bindings)
         coll-expr (second bindings)
         s (gensym "s__")]
    (list 'loop [s (list '__seq coll-expr)]
      (list 'when (list 'not (list 'empty? s))
        (list 'let [sym (list 'first s)]
          (cons 'do body)
          (list 'recur (list 'rest s)))))))

; (binding [*x* 1 *y* 2] body...): while body runs, the running task (and
; tasks it spawns) sees its own values for these dynamic vars
; ((def ^:dynamic *x* ...)); they are restored afterwards, also on throw.
; Bindings live in the task, so body may yield.
(defmacro binding "Gives the dynamic vars new values in the running task (and tasks it spawns) while body runs; restores them afterwards, also on throw." [bindings & body]
  (if (odd? (count bindings))
    (throw {:message "binding: requires an even number of forms in the binding vector"}))
  (let* [g (gensym "prev-bindings")
         pairs (loop [bs bindings acc []]
                 (if (empty? bs)
                   acc
                   (recur (rest (rest bs))
                          (conj (conj acc (list 'quote (first bs))) (second bs)))))]
    (list 'let* [g (list '__push-bindings pairs)]
          (list 'try (cons 'do body) (list 'finally (list '__pop-bindings g))))))

(defmacro with-out-str "Evaluates body with *out* bound to a fresh string stream and returns what was printed." [& body]
  (let* [s (gensym "out__")]
    (list 'let* [s '(__string-stream)]
      (list 'binding ['*out* s] (cons 'do body))
      (list '__string-stream-contents s))))

; (set! *x* v) changes the running task's binding of a dynamic var
(defmacro set! "Changes the running task's binding of a dynamic var (inside binding)." [sym v]
  (list '__set! (list 'quote sym) v))

; Exception helpers
(defn ex-info "An exception map {:type :error :message msg :data data} to throw." [msg data] {:type :error :message msg :data data})

;; --- Files and loading ---
; File access goes through *fs* when an embedder sets it:
;   (def beer.core/*fs* {:read (fn [path] ...) :write! (fn [path s append?] ...)})
; :read returns the contents as a string, or nil if path can't be read.
; nil means the host file system.
(def ^:dynamic *fs*
  "nil for the host file system, or a map {:read (fn [path]) :write! (fn [path s append?])} that slurp, spit, load and require go through."
  nil)

(defn __read-file [path]
  (if *fs* ((get *fs* :read) path) (__file-read path)))

(defn slurp "The contents of the file at path as a string (through *fs* when set)." [path]
  (if *fs*
    (let* [s ((get *fs* :read) path)]
      (if (nil? s)
        (throw (ex-info (str "slurp: failed to read '" path "'") {:path path}))
        s))
    (__slurp path)))

(defn spit "Writes the string content to the file at path; :append true appends (through *fs* when set)." [path content & opts]
  (if *fs*
    ((get *fs* :write!) path content (if (= (first opts) :append) (second opts) false))
    (apply __spit path content opts)))

;; eval and load-string compile each form into a fn (__compile) and call it
;; in the caller's VM: no child task, so they yield like any other code and
;; two REPLs evaluating at once don't wait on each other.
; A top-level do is split, as in Clojure: each subform is compiled after the
; previous one ran, so (do (in-ns 'x) (def y 1)) defines x/y.
(defn eval "Evaluates form in the calling task and returns its value. A top-level do is evaluated form by form." [form]
  (let* [f (macroexpand form)]
    (if (and (list? f) (= (first f) 'do))
      (reduce (fn [_ sub] (eval sub)) nil (rest f))
      ((__compile f)))))

; Runs every form of s; the current namespace is restored afterwards
(defn load-string "Evaluates every form in the string s and returns the last value; name labels errors. The current namespace is restored afterwards."
  ([s] (load-string s "<string>"))
  ([s name]
   (let* [forms (__read-all s name)
          n (count forms)
          saved (__current-ns)]
     (try
       (loop [i 0 result nil]
         (if (< i n)
           (recur (inc i)
                  (try
                    (eval (nth forms i))
                    (catch e
                      (throw (ex-info (str "load: error in " name " (form " (inc i) "): "
                                           (or (get e :message) (pr-str e)))
                                      {:file name :form (inc i) :cause e})))))
           result))
       (finally
         (if (not= (__current-ns) saved) (in-ns saved)))))))

(defn load-file "Evaluates every form in the file at path (through *fs* when set) and returns the last value. The current namespace is restored afterwards." [path]
  (let* [src (__read-file path)]
    (if (nil? src)
      (throw (ex-info (str "load: cannot open '" path "'") {:path path}))
      (load-string src path))))

(def load "Same as load-file." load-file)
(alter-meta! 'load assoc :arglists '([path]))

; --- Namespace support ---
(def __requiring (atom []))

; [source name] for foo/bar.beer: *load-path* (through *fs*), then the
; BEERPATH tar index
(defn __require-source [rel]
  (let* [found (some (fn [dir]
                       (let* [path (str dir rel)
                              src (__read-file path)]
                         (if src [src path] nil)))
                     *load-path*)]
    (if found
      found
      (let* [src (__tar-read rel)]
        (if src [src rel] nil)))))

(defn __load-lib [ns-sym]
  (let* [k (keyword (name ns-sym))]
    (if (get *loaded-libs* k)
      nil
      (let* [rel (str (beer.string/replace (name ns-sym) "." "/") ".beer")
             found (__require-source rel)
             saved (__current-ns)
             ; natives-only namespaces (beer.bytes, an embedder's) have no file
             native-only (and (nil? found) (find-ns ns-sym) (not (empty? (ns-publics ns-sym))))]
        (if (and (nil? found) (not native-only))
          (throw (ex-info (str "require: cannot find file for '" ns-sym "'") {:ns ns-sym})))
        (if (some (fn [n] (= n ns-sym)) @__requiring)
          (throw (ex-info (str "require: circular dependency detected for '" ns-sym "'") {:ns ns-sym})))
        (swap! __requiring conj ns-sym)
        (try
          (in-ns ns-sym)
          (if found (load-string (first found) (second found)))
          (finally
            (in-ns saved)
            (swap! __requiring pop)))
        (def beer.core/*loaded-libs* (assoc *loaded-libs* k true))
        nil))))

; Group require's args into specs: 'a :as 'x '[b :refer [y]] 'c
; => [[a :as x] [b :refer [y]] [c]]. An option keyword leaves its spec
; with an even count until its value arrives.
(defn __require-specs [args]
  (reduce (fn [specs a]
            (cond
              (and (not (empty? specs)) (even? (count (peek specs))))
                (conj (pop specs) (conj (peek specs) a))
              (vector? a) (conj specs a)
              (symbol? a) (conj specs [a])
              (and (keyword? a) (not (empty? specs)))
                (conj (pop specs) (conj (peek specs) a))
              :else (throw (ex-info (str "require: unexpected argument " (pr-str a)) {:arg a}))))
          [] args))

(defn __require-one [spec]
  (let* [ns-sym (first spec)
         opts (rest spec)]
    (if (not (symbol? ns-sym))
      (throw (ex-info (str "require: expected a namespace symbol, got " (pr-str ns-sym)) {:spec spec})))
    (if (even? (count spec))
      (throw (ex-info (str "require: option without a value in " (pr-str spec)) {:spec spec})))
    (let* [opts (apply hash-map opts)
           alias (get opts :as)
           refer (get opts :refer)]
      (if (some (fn [k] (not (or (= k :as) (= k :refer)))) (keys opts))
        (throw (ex-info "require: unknown option (expected :as or :refer)" {:spec spec})))
      (if (and alias (not (symbol? alias)))
        (throw (ex-info "require: :as alias must be a symbol" {:spec spec})))
      (__load-lib ns-sym)
      (if alias (__alias! alias ns-sym))
      (if refer (__refer! ns-sym refer)))))

; (require 'foo.bar), (require 'foo.bar :as 'fb :refer '[x]),
; (require '[foo.bar :as fb] '[baz :refer :all] 'qux)
(defn require "Loads libraries once each and sets up aliases and refers: (require '[a.b :as ab :refer [x]] 'c) or (require 'a.b :as 'ab)." [& args]
  (reduce (fn [_ spec] (__require-one spec)) nil (__require-specs args))
  nil)

; ns macro: (ns foo.bar (:require [baz :as b :refer [x]] other))
; Expands to: (do (in-ns 'foo.bar) (require '[baz :as b :refer [x]] 'other))
(defn __ns-require-clause [clause]
  (list 'quote clause))

(defmacro ns "Makes name the current namespace (creating it) and loads the libraries in a (:require ...) clause." [name & clauses]
  (let* [in-ns-form (list 'in-ns (list 'quote name))
         list-clauses (filter list? clauses)
         require-forms
           (if (empty? list-clauses)
             '()
             (let* [clause (first list-clauses)]
               (if (= (first clause) :require)
                 (list (cons 'require (map __ns-require-clause (rest clause))))
                 '())))]
    (cons 'do (cons in-ns-form require-forms))))

;; ============================================================
;; Multimethods
;; ============================================================

(defmacro defmulti "Defines a multimethod name that calls the method registered with defmethod for (dispatch-fn args...), or the :default one." [name dispatch-fn]
  (let* [methods-sym (symbol (str name "-__methods"))
         dispatch-sym (symbol (str name "-__dispatch"))
         dv-sym (gensym "dv")
         m-sym (gensym "m")
         bindings (vector dv-sym (list 'apply dispatch-sym 'args)
                          m-sym (list 'get methods-sym dv-sym
                                      (list 'get methods-sym :default)))
         err-expr (list 'throw
                    (list 'ex-info
                      (list 'str "No method in " (str name)
                            " for dispatch value: " dv-sym)
                      {:name (str name) :dispatch-value dv-sym}))]
    (list 'do
      (list 'def methods-sym {})
      (list 'def dispatch-sym dispatch-fn)
      (list 'defn name ['& 'args]
        (list 'let* bindings
          (list 'if m-sym
            (list 'apply m-sym 'args)
            err-expr))))))

(defmacro defmethod "Adds the method for dispatch-val to the multimethod name." [name dispatch-val params & body]
  (let* [methods-sym (symbol (str name "-__methods"))]
    (list 'def methods-sym
      (list 'assoc methods-sym dispatch-val
        (cons 'fn (cons params body))))))


; time: evaluate expr, print the elapsed wall time, return its value
(defmacro time "Evaluates expr, prints the elapsed time in milliseconds and returns its value." [expr]
  (let* [start (gensym "time__")
         ret (gensym "ret__")]
    (list 'let* [start '(nano-time)
                 ret expr]
      (list 'prn (list 'str "Elapsed time: "
                       (list '/ (list 'float (list '- '(nano-time) start)) 1000000.0)
                       " msecs"))
      ret)))
