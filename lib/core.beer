; Beerlang Core Macros
; Loaded at startup by the runtime.

; defn: convenience for (def name (fn name ...))
; Single arity:  (defn name [params] body...)
; Multi-arity:   (defn name ([params1] body1...) ([params2] body2...) ...)
; Optional docstring: (defn name "docstring" [params] body...)
(defmacro defn [name & fdecl]
  (let* [has-doc (string? (first fdecl))
         docstring (if has-doc (first fdecl) nil)
         fdecl (if has-doc (rest fdecl) fdecl)
         base (if (vector? (first fdecl))
                ; Single arity
                (list (quote def) name (cons (quote fn) (cons name fdecl)))
                ; Multi-arity
                (let* [arities fdecl
                       clauses (__multi-arity-clauses arities)
                       err-expr (list (quote __arity-error)
                                      (list (quote str)
                                            (str name)
                                            " called with wrong number of args: "
                                            (list (quote count) (quote __args))))
                       full-clauses (concat clauses (list :else err-expr))]
                  (list (quote def) name
                        (list (quote fn) name (quote [& __args])
                              (cons (quote cond) full-clauses)))))]
    (if has-doc
      (list (quote do) base
            (list (quote alter-meta!) (list (quote quote) name) (quote assoc) :doc docstring)
            name)
      base)))

; Helper: build cond clauses for multi-arity dispatch
(defn __multi-arity-clauses [arities]
  (if (empty? arities)
    '()
    (let* [arity (first arities)
           params (first arity)
           body (rest arity)
           n (count params)]
      (concat (list (list (quote =) (list (quote count) (quote __args)) n)
                    (list (quote apply) (cons (quote fn) arity) (quote __args)))
              (__multi-arity-clauses (rest arities))))))

; doc: print documentation for a symbol
(defmacro doc [sym]
  (list (quote __print-doc) (str sym) (list (quote meta) (list (quote quote) sym))))

; when: (when test body...) => (if test (do body...) nil)
(defmacro when [test & body]
  (list (quote if) test (cons (quote do) body) nil))

; and: short-circuit logical and
(defmacro and [& args]
  (if (empty? args) true
    (if (= (count args) 1) (first args)
      (list (quote if) (first args)
        (cons (quote and) (rest args))
        false))))

; or: short-circuit logical or (uses gensym to avoid double evaluation)
(defmacro or [& args]
  (if (empty? args) nil
    (if (= (count args) 1) (first args)
      (let* [v (gensym "or__")]
        (list (quote let*) [v (first args)]
              (list (quote if) v v
                    (cons (quote or) (rest args))))))))

; cond: (cond test1 expr1 test2 expr2 ... :else default)
(defmacro cond [& clauses]
  (if (empty? clauses) nil
    (if (= (count clauses) 1)
      (first clauses)
      (list (quote if) (first clauses)
        (first (rest clauses))
        (cons (quote cond) (rest (rest clauses)))))))

; ->: thread-first macro
; (-> x (f a) (g b)) => (g (f x a) b)
(defmacro -> [x & forms]
  (if (empty? forms) x
    (let* [form (first forms)
           threaded (if (list? form)
                      (cons (first form) (cons x (rest form)))
                      (list form x))]
      (cons (quote ->) (cons threaded (rest forms))))))

; ->>: thread-last macro
; (->> x (f a) (g b)) => (g a (f a x))  -- actually (g b (->> x (f a)))
(defmacro ->> [x & forms]
  (if (empty? forms) x
    (let* [form (first forms)
           threaded (if (list? form)
                      (concat form (list x))
                      (list form x))]
      (cons (quote ->>) (cons threaded (rest forms))))))

; --- let with destructuring ---
; Helper: build nthrest expression (chain of rest calls)
(defn __nthrest-expr [sym n]
  (loop [i 0 v sym]
    (if (= i n) v
      (recur (+ i 1) (list 'rest v)))))

; Helper: flat let* binding pairs for binding `target` (a symbol or a
; destructuring vector, possibly nested) to expr
(defn __bind-pairs [target expr]
  (if (vector? target)
    (__expand-destructure target expr)
    (list target expr)))

; Helper: expand a destructuring vector pattern into flat let* binding pairs
(defn __expand-destructure [pattern expr]
  (let* [tmp (gensym "destr__")]
    (loop [i 0
           bindings (list tmp expr)
           elems pattern]
      (if (empty? elems)
        bindings
        (let* [elem (first elems)]
          (if (= elem '&)
            (concat bindings (__bind-pairs (first (rest elems))
                                           (__nthrest-expr tmp i)))
            (if (= elem :as)
              (concat bindings (list (first (rest elems)) tmp))
              (recur (+ i 1)
                     (concat bindings (__bind-pairs elem (list 'nth tmp i nil)))
                     (rest elems)))))))))

; Helper: expand all bindings, handling destructuring vectors
(defn __expand-bindings [bindings]
  (loop [i 0
         result '()]
    (if (>= i (count bindings))
      result
      (let* [binding (nth bindings i)
             expr    (nth bindings (+ i 1))]
        (if (vector? binding)
          (recur (+ i 2) (concat result (__expand-destructure binding expr)))
          (recur (+ i 2) (concat result (list binding expr))))))))

; let: supports destructuring via macro expansion to let*
(defmacro let [bindings & body]
  (let* [expanded (__expand-bindings bindings)]
    (cons 'let* (cons (apply vector expanded) body))))

; Arity error helper (until we have throw)
(defn __arity-error [msg] (println "ERROR:" msg) nil)

; --- Numeric utilities ---
(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))
(defn zero? [x] (= x 0))
(defn pos? [x] (> x 0))
(defn neg? [x] (< x 0))
(defn even? [x] (= 0 (mod x 2)))
(defn odd? [x] (not (even? x)))

; --- Comparison utilities ---
(defn not= [a b] (not (= a b)))
(defn max [& args] (reduce (fn [a b] (if (> a b) a b)) (first args) (rest args)))
(defn min [& args] (reduce (fn [a b] (if (< a b) a b)) (first args) (rest args)))
(defn abs [x] (if (neg? x) (- x) x))

; --- Function utilities ---
(defn identity [x] x)
(defn boolean "true unless x is nil or false" [x] (if x true false))
(defn constantly [x] (fn [& _] x))
(defn complement [f] (fn [& args] (not (apply f args))))
(defn comp [& fns]
  (if (empty? fns) identity
    (if (empty? (rest fns)) (first fns)
      (let* [f (first fns)
             g (apply comp (rest fns))]
        (fn [& args] (f (apply g args)))))))
(defn partial [f & bound]
  (fn [& args] (apply f (concat bound args))))
(defn juxt [& fns]
  (fn [& args]
    (let* [results (map (fn [f] (apply f args)) fns)]
      (into [] results))))

; --- Collection utilities ---
; Builders accumulate in reverse with cons (O(1)) and flip once with __rev,
; instead of (concat acc (list x)), which copies acc every step. Loops start
; from (__seq coll) because rest on a vector copies the remainder each call.
(defn __rev [lst]
  (loop [s lst acc '()]
    (if (empty? s)
      acc
      (recur (rest s) (cons (first s) acc)))))

(defn filter [pred coll]
  (loop [s   (__seq coll)
         acc '()]
    (if (empty? s)
      (__rev acc)
      (recur (rest s)
             (if (pred (first s))
               (cons (first s) acc)
               acc)))))

(defn reduce [f init coll]
  (loop [acc init
         s   (__seq coll)]
    (if (empty? s)
      acc
      (recur (f acc (first s)) (rest s)))))

(defn map [f coll]
  (loop [s   (__seq coll)
         acc '()]
    (if (empty? s)
      (__rev acc)
      (recur (rest s) (cons (f (first s)) acc)))))

; --- More collection utilities ---
(defn second [coll] (first (rest coll)))
(defn ffirst [coll] (first (first coll)))

(defn last [coll]
  (loop [s (__seq coll)]
    (if (empty? (rest s))
      (first s)
      (recur (rest s)))))

(defn butlast [coll]
  (loop [s (__seq coll) acc '()]
    (if (empty? (rest s))
      (__rev acc)
      (recur (rest s) (cons (first s) acc)))))

(defn take [n coll]
  (loop [i 0 s (__seq coll) acc '()]
    (if (or (= i n) (empty? s))
      (__rev acc)
      (recur (+ i 1) (rest s) (cons (first s) acc)))))

; drop/drop-while return the remainder itself, so coll is only converted
; once at least one element is actually dropped -- (drop 0 v) stays v.
(defn drop [n coll]
  (if (or (<= n 0) (empty? coll))
    coll
    (loop [i 1 s (rest (__seq coll))]
      (if (or (= i n) (empty? s))
        s
        (recur (+ i 1) (rest s))))))

(defn take-while [pred coll]
  (loop [s (__seq coll) acc '()]
    (if (or (empty? s) (not (pred (first s))))
      (__rev acc)
      (recur (rest s) (cons (first s) acc)))))

(defn drop-while [pred coll]
  (if (or (empty? coll) (not (pred (first coll))))
    coll
    (loop [s (rest (__seq coll))]
      (if (or (empty? s) (not (pred (first s))))
        s
        (recur (rest s))))))

(defn partition
  "Lists of n items each, starting a new one every step items (default n).
  A final chunk with fewer than n items is dropped."
  ([n coll] (partition n n coll))
  ([n step coll]
    (if (or (< n 1) (< step 1))
      (throw (ex-info "partition: n and step must be positive" {:n n :step step}))
      (loop [s (__seq coll) acc '()]
        (let* [chunk (take n s)]
          (if (< (count chunk) n)
            (__rev acc)
            (recur (drop step s) (cons chunk acc))))))))

(defn range [& args]
  (let* [start (if (>= (count args) 2) (first args) 0)
         end   (if (>= (count args) 2) (second args) (first args))
         step  (if (>= (count args) 3) (nth args 2) 1)
         done? (cond (pos? step) (fn [i] (>= i end))
                     (neg? step) (fn [i] (<= i end))
                     :else (throw (ex-info "range: step must be non-zero" {:step step})))]
    (loop [i start acc '()]
      (if (done? i)
        (__rev acc)
        (recur (+ i step) (cons i acc))))))

(defn repeat [n x]
  (loop [i 0 acc '()]
    (if (= i n)
      acc
      (recur (+ i 1) (cons x acc)))))

(defn repeatedly [n f]
  (loop [i 0 acc '()]
    (if (= i n)
      (__rev acc)
      (recur (+ i 1) (cons (f) acc)))))

(defn reverse [coll]
  (reduce (fn [acc x] (cons x acc)) '() coll))

(defn into [to from]
  (reduce conj to from))

(defn vec [coll]
  (into [] coll))

(defn some [pred coll]
  (loop [s (__seq coll)]
    (if (empty? s)
      nil
      (let* [result (pred (first s))]
        (if result result (recur (rest s)))))))

(defn every? [pred coll]
  (loop [s (__seq coll)]
    (if (empty? s)
      true
      (if (pred (first s))
        (recur (rest s))
        false))))

(defn not-any? [pred coll] (not (some pred coll)))
(defn not-every? [pred coll] (not (every? pred coll)))

(defn frequencies [coll]
  (reduce (fn [m x]
            (let* [n (get m x 0)]
              (assoc m x (+ n 1))))
          {} coll))

(defn group-by [f coll]
  (let* [reversed (reduce (fn [m x]
                            (let* [k (f x)]
                              (assoc m k (cons x (get m k '())))))
                          {} coll)]
    (reduce-kv (fn [m k v] (assoc m k (__rev v))) {} reversed)))

(defn mapcat [f coll]
  (__rev (reduce (fn [acc x] (reduce (fn [a y] (cons y a)) acc (f x)))
                 '() coll)))

(defn interleave [c1 c2]
  (loop [s1 (__seq c1) s2 (__seq c2) acc '()]
    (if (or (empty? s1) (empty? s2))
      (__rev acc)
      (recur (rest s1) (rest s2)
             (cons (first s2) (cons (first s1) acc))))))

(defn zipmap [keys vals]
  (loop [ks (__seq keys) vs (__seq vals) m {}]
    (if (or (empty? ks) (empty? vs))
      m
      (recur (rest ks) (rest vs) (assoc m (first ks) (first vs))))))

(defn __flatten-into [acc coll]
  (reduce (fn [a x]
            (if (or (list? x) (vector? x))
              (__flatten-into a x)
              (cons x a)))
          acc coll))

(defn flatten [coll]
  (__rev (__flatten-into '() coll)))

(defn distinct [coll]
  (loop [s (__seq coll) seen {} acc '()]
    (if (empty? s)
      (__rev acc)
      (let* [x (first s)]
        (if (contains? seen x)
          (recur (rest s) seen acc)
          (recur (rest s) (assoc seen x true) (cons x acc)))))))

(defn select-keys [m ks]
  (reduce (fn [acc k]
            (if (contains? m k)
              (assoc acc k (get m k))
              acc))
          {} ks))

; --- Sorting ---
; A comparator is either 3-way (negative/zero/positive, like `compare`) or a
; boolean predicate "a comes before b" (like `<`). As in Clojure, a boolean
; result is turned into 3-way by also asking (comp b a).
(defn __comparator [comp]
  (fn [a b]
    (let* [r (comp a b)]
      (cond (number? r) r
            r -1
            (comp b a) 1
            :else 0))))

; Prepend the reversed `rev` onto `tail` (O(len rev), no copying of tail)
(defn __rev-onto [rev tail]
  (loop [r rev out tail]
    (if (empty? r)
      out
      (recur (rest r) (cons (first r) out)))))

; Stable merge of two sorted lists. A loop with an accumulator, so the
; depth doesn't grow with the input (cons-ing onto a recursive call did).
(defn __merge [cmp a b]
  (loop [a a b b acc '()]
    (cond (empty? a) (__rev-onto acc b)
          (empty? b) (__rev-onto acc a)
          (<= (cmp (first a) (first b)) 0) (recur (rest a) b (cons (first a) acc))
          :else (recur a (rest b) (cons (first b) acc)))))

; Top-down merge sort on a list of known length (recursion depth is log n)
(defn __sort-list [cmp lst n]
  (if (<= n 1)
    lst
    (let* [mid (quot n 2)]
      (__merge cmp
               (__sort-list cmp (take mid lst) mid)
               (__sort-list cmp (drop mid lst) (- n mid))))))

(defn sort
  "Sorted sequence of coll's elements, by `compare` or the given comparator
  (3-way or boolean predicate). Stable. With `compare` (the default) the
  sort runs natively; a custom comparator is called per comparison."
  ([coll] (__sort-native coll))
  ([comp coll]
    (if (= comp compare)
      (__sort-native coll)
      (let* [s (__seq coll)]
        (__sort-list (__comparator comp) s (count s))))))

(defn sort-by
  "Sort coll by (keyfn x), using `compare` or the given comparator. Stable.
  With `compare` (the default) keyfn runs once per element and the sort
  runs natively."
  ([keyfn coll] (__sort-pairs-native (map (fn [x] [(keyfn x) x]) coll)))
  ([keyfn comp coll]
    (if (= comp compare)
      (sort-by keyfn coll)
      (let* [cmp (__comparator comp)]
        (sort (fn [a b] (cmp (keyfn a) (keyfn b))) coll)))))

; --- Nested collection access ---
(defn get-in [m ks]
  (reduce get m ks))

(defn assoc-in [m ks v]
  (if (= (count ks) 1)
    (assoc m (first ks) v)
    (assoc m (first ks)
           (assoc-in (get m (first ks) {}) (rest ks) v))))

(defn update [m k f & args]
  (assoc m k (apply f (get m k) args)))

(defn update-in [m ks f & args]
  (if (= (count ks) 1)
    (apply update m (first ks) f args)
    (assoc m (first ks)
           (apply update-in (get m (first ks) {}) (rest ks) f args))))

(defn merge [& maps]
  (reduce (fn [acc m]
            (if (nil? m) acc
              (reduce (fn [a k] (assoc a k (get m k)))
                      acc (keys m))))
          {} maps))

; --- I/O helpers ---
(defmacro with-open [bindings & body]
  (let* [name (first bindings)
         init (second bindings)
         result (gensym "result__")]
    (list (quote let*) [name init]
      (list (quote try)
        (list (quote let*) [result (cons (quote do) body)]
          (list (quote close) name)
          result)
        (list (quote catch) (quote e)
          (list (quote do)
            (list (quote close) name)
            (list (quote throw) (quote e))))))))

; doseq: iterate a collection for side effects
; (doseq [x coll] body...)
(defmacro doseq [bindings & body]
  (let* [sym (first bindings)
         coll-expr (second bindings)
         s (gensym "s__")]
    (list 'loop [s coll-expr]
      (list 'when (list 'not (list 'empty? s))
        (list 'let* [sym (list 'first s)]
          (cons 'do body)
          (list 'recur (list 'rest s)))))))

; Exception helpers
(defn ex-info [msg data] {:type :error :message msg :data data})

; --- Namespace support ---
; ns macro: (ns foo.bar (:require [baz :as b :refer [x]] other))
; Expands to: (do (in-ns 'foo.bar) (require 'baz :as 'b :refer '[x]) (require 'other))
(defn __ns-require-clause [clause]
  (if (vector? clause)
    ; [foo.bar :as fb :refer [x]] => (require 'foo.bar :as 'fb :refer '[x])
    (cons 'require
          (cons (list 'quote (first clause))
                (mapcat (fn [kv] (list (first kv) (list 'quote (second kv))))
                        (partition 2 (rest clause)))))
    ; bare symbol => (require 'sym)
    (list 'require (list 'quote clause))))

(defmacro ns [name & clauses]
  (let* [in-ns-form (list 'in-ns (list 'quote name))
         list-clauses (filter list? clauses)
         require-forms
           (if (empty? list-clauses)
             '()
             (let* [clause (first list-clauses)]
               (if (= (first clause) :require)
                 (map __ns-require-clause (rest clause))
                 '())))]
    (cons 'do (cons in-ns-form require-forms))))

;; ============================================================
;; Multimethods
;; ============================================================

(defmacro defmulti [name dispatch-fn]
  (let* [methods-sym (symbol (str name "-__methods"))
         dispatch-sym (symbol (str name "-__dispatch"))
         dv-sym (gensym "dv")
         m-sym (gensym "m")
         bindings (vector dv-sym (list 'apply dispatch-sym 'args)
                          m-sym (list 'get methods-sym dv-sym
                                      (list 'get methods-sym :default)))
         err-expr (list 'throw
                    (list 'ex-info
                      (list 'str "No method in " (str name)
                            " for dispatch value: " dv-sym)
                      {:name (str name) :dispatch-value dv-sym}))]
    (list 'do
      (list 'def methods-sym {})
      (list 'def dispatch-sym dispatch-fn)
      (list 'defn name ['& 'args]
        (list 'let* bindings
          (list 'if m-sym
            (list 'apply m-sym 'args)
            err-expr))))))

(defmacro defmethod [name dispatch-val params & body]
  (let* [methods-sym (symbol (str name "-__methods"))]
    (list 'def methods-sym
      (list 'assoc methods-sym dispatch-val
        (cons 'fn (cons params body))))))

