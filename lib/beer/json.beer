(ns beer.json
  "JSON parser and emitter — natives registered by core_register_json().

  Functions:
    (parse str) → value   objects → maps with string keys, arrays → vectors,
                          integers → fixnum/bigint, decimals → float
    (emit x)    → string  maps, vectors, lists, sets, strings, keywords and
                          symbols (as strings), numbers, booleans, nil")

;; Natives are pre-registered by core_register_json() in C.
;; This file exists so (require 'beer.json) finds the namespace.
